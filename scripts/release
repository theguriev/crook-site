#!/bin/sh
#
# Cut a release of the site: bump the version, write its changelog, commit, tag.
#
#   scripts/release 0.2.0                  # everything below, leaving the tag unpushed
#   scripts/release 0.2.0 --push           # and push main with the tag
#   scripts/release 0.2.0 --dry-run        # print the changelog it would write and stop
#   scripts/release 0.2.0 --allow-untyped  # release over commits the changelog cannot list
#
# A tag here publishes nothing by itself: the site goes out when somebody runs
# scripts/deploy.sh, which builds the working tree on the server. What the tag
# is for is saying which version of the site is the one running — the `version`
# in package.json, the `## vX.Y.Z` section in CHANGELOG.md and the tag are set
# together, so that "what is on crook.id" has an answer that is not a commit
# hash.
#
#   1. The tree is clean, on main, and the version is newer than the last tag.
#   2. `npm version --no-git-tag-version` writes package.json and the lockfile;
#      it makes no commit and no tag of its own, because the ones below carry
#      the changelog with them.
#   3. changelogen prepends the `## vX.Y.Z` section to CHANGELOG.md from the
#      commits since the previous tag, grouped by the types in
#      changelog.config.json.
#   4. One commit, `chore(release): vX.Y.Z`, and an annotated tag on it.
#
# The generator reads only Conventional Commit titles and drops the rest
# without a word, which is what --allow-untyped acknowledges — the first
# release after this script arrives needs it, since the history behind it
# predates the convention.
#
# changelogen is pinned rather than @latest, and run through npx rather than
# installed: it is needed twice a month, and a dependency in package.json is a
# dependency `npm ci` installs on every deploy build.
set -eu

CHANGELOGEN="changelogen@0.6.2"

here=$(cd "$(dirname "$0")/.." && pwd)
cd "$here"

version=${1:-}
case "$version" in
  [0-9]*.[0-9]*.[0-9]*) ;;
  *) echo "usage: scripts/release X.Y.Z [--push] [--dry-run] [--allow-untyped]" >&2; exit 2 ;;
esac
shift
push=; dry=; allow_untyped=
for arg in "$@"; do
  case "$arg" in
    --push) push=1 ;;
    --dry-run) dry=1 ;;
    --allow-untyped) allow_untyped=1 ;;
    *) echo "release: unknown option $arg" >&2; exit 2 ;;
  esac
done
tag="v$version"

fail() { echo "release: $1" >&2; exit 1; }

command -v npm >/dev/null || fail "node is needed — https://nodejs.org"
[ "$(git branch --show-current)" = main ] || fail "release from main, not $(git branch --show-current)"
[ -z "$(git status --porcelain)" ] || fail "the tree is not clean"
git rev-parse -q --verify "refs/tags/$tag" >/dev/null && fail "$tag already exists"

previous=$(git tag --list 'v[0-9]*' --sort=-v:refname | head -1)
if [ -n "$previous" ]; then
  from=$previous
  newest=$(printf '%s\n%s\n' "${previous#v}" "$version" | sort -V | tail -1)
  [ "$newest" = "$version" ] && [ "$version" != "${previous#v}" ] \
    || fail "$version is not newer than $previous"
else
  from=$(git rev-list --max-parents=0 HEAD | tail -1)
  echo "==> no v* tag yet; the changelog starts at the root commit"
fi
range="$from..HEAD"
[ "$(git rev-list --count "$range")" -gt 0 ] || fail "nothing since $from"

echo "==> $from → $tag, $(git rev-list --count "$range") commits"

if ! ./scripts/commit-lint "$range"; then
  if [ -n "$allow_untyped" ]; then
    echo "==> --allow-untyped: the titles above will be missing from the notes"
  else
    fail "those would be dropped from the changelog; fix the titles or pass --allow-untyped"
  fi
fi

if [ -n "$dry" ]; then
  echo "==> The changelog section, not written:"
  npx --yes "$CHANGELOGEN" --from "$from" --to HEAD -r "$version" --no-output
  exit 0
fi

echo "==> Setting package.json to $version"
npm version --no-git-tag-version "$version" >/dev/null
grep -q "\"version\": \"$version\"" package.json || fail "could not set the version in package.json"

echo "==> Writing CHANGELOG.md"
npx --yes "$CHANGELOGEN" --from "$from" --to HEAD -r "$version" --output CHANGELOG.md >/dev/null
grep -q "^## $tag" CHANGELOG.md || fail "changelogen wrote no '## $tag' section"

git add package.json package-lock.json CHANGELOG.md
git commit -q -m "chore(release): $tag"
git tag -a "$tag" -m "$tag"
echo "==> Committed and tagged $tag"
./scripts/release-notes "$tag"

if [ -n "$push" ]; then
  echo "==> Pushing main and $tag"
  git push origin main "$tag"
  echo "==> Nothing deploys on a tag. When it should be live:  scripts/deploy.sh"
else
  echo "==> Not pushed. When it looks right:  git push origin main $tag"
fi
